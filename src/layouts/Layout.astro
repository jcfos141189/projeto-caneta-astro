---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/tailwind.generated.css';

interface Props {
    title?: string;
    activeItem?: 'inicio' | 'sobre' | 'loja' | 'catalogo' | 'detalhes';
}

const { 
    title = "BNI Nikiti Pigmentum 0.1 — Caneta de Precisão Arquitetural", 
    activeItem = "inicio" 
} = Astro.props;

const isHome = activeItem === "inicio";
---
<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Preconnect to Font CDNs -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Google Fonts (Optimized Non-Blocking Font Loading) -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Pinyon+Script&family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap" media="print" onload="this.media='all'" />
    <noscript>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Pinyon+Script&family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap" />
    </noscript>

    {isHome && (
        <>
            <!-- GSAP & ScrollTrigger (Deferred for Page Performance) -->
            <script is:inline defer src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
            <script is:inline defer src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

            <!-- Lenis Smooth Scrolling (Deferred) -->
            <script is:inline defer src="https://unpkg.com/lenis@1.1.20/dist/lenis.min.js"></script>
        </>
    )}
</head>

<body class="antialiased selection:bg-stone-900 selection:text-white">
    <!-- Subtle Architectural Film Grain Overlay -->
    <div class="noise" aria-hidden="true"></div>

    <!-- Header Component -->
    <Header activeItem={activeItem} />

    <!-- Slot for Page Content -->
    <slot />

    <!-- Footer Component -->
    <Footer />
</body>

</html>

<style is:global>
    /* ==========================================================================
       1. DESIGN SYSTEM TOKENS (Extracted from assets/design_system.html)
       ========================================================================== */
    :root {
        --bg-main: #FFFFFF;
        --bg-secondary: #F5F5F0;
        --bg-architect: #EAEAE5;
        --text-primary: #1C1C1C;
        --text-secondary: #6B6B6B;
        --text-muted: #78716C;
        --border-color: #D6D3D1;
        --accent: #1C1C1C;
        --accent-kinetic: #FF3300;
        --accent-acid: #CCFF00;
        --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
        --ease-elastic: cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    html {
        background-color: var(--bg-secondary);
        color: var(--text-primary);
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }

    body {
        background-color: var(--bg-secondary);
        color: var(--text-primary);
        overflow-x: hidden;
        selection-background-color: #1C1C1C;
        selection-color: #FFFFFF;
    }

    ::selection {
        background: var(--text-primary);
        color: var(--bg-main);
    }

    /* ==========================================================================
       2. ATMOSPHERIC SURFACES, NOISE & ARCHITECTURAL GRID
       ========================================================================== */
    .noise {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0.028;
        pointer-events: none;
        z-index: 9999;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    }

    .bg-grid-architect {
        background-size: 48px 48px;
        background-image:
            linear-gradient(to right, rgba(28, 28, 28, 0.035) 1px, transparent 1px),
            linear-gradient(to bottom, rgba(28, 28, 28, 0.035) 1px, transparent 1px);
    }

    /* Subtle Studio Radial Lighting matching video2.mp4 studio backdrop */
    .hero-studio-backdrop {
        background:
            radial-gradient(circle at 50% 52%, #FFFFFF 0%, #F7F7F4 42%, #EAEAE5 82%, #E2E1DC 100%);
    }

    /* ==========================================================================
       3. HEADER & GLASS NAVIGATION
       ========================================================================== */
    .site-header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 100;
        transition: background-color 0.45s var(--ease-out),
                    backdrop-filter 0.45s var(--ease-out),
                    border-color 0.45s var(--ease-out),
                    padding 0.45s var(--ease-out),
                    box-shadow 0.45s var(--ease-out);
        border-bottom: 1px solid transparent;
    }

    .site-header.is-scrolled,
    .site-header.is-subpage {
        background-color: rgba(245, 245, 240, 0.88);
        backdrop-filter: blur(20px) saturate(180%);
        -webkit-backdrop-filter: blur(20px) saturate(180%);
        border-bottom-color: rgba(214, 211, 209, 0.85);
        box-shadow: 0 10px 30px -12px rgba(28, 28, 28, 0.08);
    }

    .nav-link {
        position: relative;
        font-size: 0.8125rem;
        font-weight: 500;
        letter-spacing: 0.02em;
        color: var(--text-secondary);
        transition: color 0.3s var(--ease-out);
    }

    .nav-link::after {
        content: '';
        position: absolute;
        left: 0;
        bottom: -4px;
        width: 100%;
        height: 1.5px;
        background: var(--text-primary);
        transform: scaleX(0);
        transform-origin: right;
        transition: transform 0.4s var(--ease-out);
    }

    .nav-link:hover,
    .nav-link.active {
        color: var(--text-primary);
    }

    .nav-link:hover::after,
    .nav-link.active::after {
        transform: scaleX(1);
        transform-origin: left;
    }

    /* ==========================================================================
       4. GIANT TRANSLUCENT / HOLLOW TYPOGRAPHY & LIGHT PORTAL LETTERING
       ========================================================================== */
    .giant-brand-watermark {
        font-family: 'Space Grotesk', 'Inter', sans-serif;
        font-size: clamp(4.75rem, 17.5vw, 19rem);
        font-weight: 700;
        letter-spacing: -0.055em;
        line-height: 0.84;
        text-transform: uppercase;
        white-space: nowrap;
        user-select: none;
        pointer-events: none;
        color: rgba(28, 28, 28, 0.042);
        -webkit-text-stroke: 1.5px rgba(28, 28, 28, 0.14);
        background: linear-gradient(180deg, rgba(28, 28, 28, 0.11) 0%, rgba(28, 28, 28, 0.02) 100%);
        -webkit-background-clip: text;
        background-clip: text;
        will-change: transform, opacity;
    }

    .lettering-transparent {
        color: transparent;
        -webkit-text-stroke: 1.5px rgba(28, 28, 28, 0.4);
        transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        display: inline-block;
    }

    .lettering-transparent:hover,
    .group:hover .lettering-transparent {
        color: rgba(28, 28, 28, 0.05);
        -webkit-text-stroke: 1.5px rgba(28, 28, 28, 0.95);
        text-shadow: 0 10px 30px rgba(28, 28, 28, 0.08);
    }

    .lettering-transparent-outline {
        color: transparent;
        -webkit-text-stroke: 1.25px rgba(28, 28, 28, 0.22);
        display: inline-block;
    }

    .lettering-image-clip {
        background: linear-gradient(
            135deg, 
            #1C1C1C 0%, 
            #2B2825 30%, 
            #8A6B47 50%, 
            #C4A265 56%, 
            #2B2825 70%, 
            #1C1C1C 100%
        );
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        display: inline-block;
        filter: none;
        transition: filter 0.3s ease;
    }

    .lettering-image-clip:hover,
    .group:hover .lettering-image-clip {
        filter: brightness(1.1);
    }

    @keyframes lightSweep {
        0% { background-position: -180% center; }
        100% { background-position: 180% center; }
    }

    .lettering-light-gleam {
        background: linear-gradient(
            110deg,
            #1C1C1C 0%,
            #44413E 26%,
            #E2BA84 46%,
            #FFFDF2 50%,
            #E2BA84 54%,
            #2F2D2B 74%,
            #1C1C1C 100%
        );
        background-size: 250% 100%;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        animation: lightSweep 7s ease-in-out infinite;
        display: inline-block;
    }

    .gradient-text {
        background: linear-gradient(135deg, #1C1C1C 0%, #57534E 62%, #8C8885 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        display: inline-block;
    }

    /* ==========================================================================
       5. SCROLL-BOUND VIDEO STAGE & BLEND OPTICS
       ========================================================================== */
    .hero-scroll-track {
        position: relative;
        height: 450vh;
        width: 100%;
    }

    .hero-sticky-viewport {
        position: sticky;
        top: 0;
        left: 0;
        width: 100%;
        height: 100vh;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .video-stage-wrapper {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 15;
        pointer-events: none;
        will-change: transform;
    }

    .video-frame-container {
        position: relative;
        width: 100vw;
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 0;
        overflow: hidden;
        will-change: transform, filter;
        mix-blend-mode: multiply;
    }

    .video-frame-container.notebook-phase {
        mix-blend-mode: normal;
    }

    #hero-canvas {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        will-change: transform;
        pointer-events: none;
    }

    /* ==========================================================================
       6. BEAM BUTTONS & MICRO-INTERACTIONS
       ========================================================================== */
    .beam-button {
        position: relative;
        overflow: hidden;
        transition: transform 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out);
    }

    .beam-button::before {
        content: '';
        position: absolute;
        top: 0;
        left: -110%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.28), transparent);
        transition: left 0.65s var(--ease-out);
        z-index: 20;
        pointer-events: none;
    }

    .beam-button:hover::before {
        left: 110%;
    }

    .beam-button:hover {
        transform: translateY(-2px) scale(1.015);
        box-shadow: 0 18px 40px -10px rgba(28, 28, 28, 0.28), 0 0 25px rgba(28, 28, 28, 0.1);
    }

    .beam-button:active {
        transform: translateY(0) scale(0.99);
    }

    .icon-pill-btn {
        width: 38px;
        height: 38px;
        border-radius: 8px;
        border: 1px solid rgba(214, 211, 209, 0.9);
        background: rgba(255, 255, 255, 0.72);
        backdrop-filter: blur(10px);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--text-primary);
        transition: all 0.35s var(--ease-out);
    }

    .icon-pill-btn.hidden {
        display: none !important;
    }

    @media (min-width: 768px) {
        .icon-pill-btn.md\:inline-flex {
            display: inline-flex !important;
        }
    }

    .icon-pill-btn:hover {
        background: var(--text-primary);
        color: #FFFFFF;
        border-color: var(--text-primary);
        transform: translateY(-1.5px);
    }

    /* ==========================================================================
       7. RIGHT-SIDE VERTICAL PAGINATION & SCROLL DOWN INDICATOR
       ========================================================================== */
    .pagination-rail {
        position: absolute;
        right: clamp(1.25rem, 3.5vw, 3.25rem);
        top: 50%;
        transform: translateY(-50%);
        z-index: 40;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.85rem;
    }

    .pagination-track {
        width: 1.5px;
        height: 110px;
        background: rgba(28, 28, 28, 0.12);
        position: relative;
        overflow: hidden;
        border-radius: 999px;
    }

    .pagination-fill {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: var(--text-primary);
        transform-origin: top;
        transform: scaleY(0.045);
    }

    .scroll-mouse-indicator {
        width: 20px;
        height: 32px;
        border: 1.5px solid rgba(28, 28, 28, 0.32);
        border-radius: 999px;
        display: flex;
        justify-content: center;
        padding-top: 5px;
    }

    .scroll-mouse-wheel {
        width: 2.5px;
        height: 6px;
        border-radius: 999px;
        background: var(--text-primary);
        animation: scrollWheel 1.8s var(--ease-out) infinite;
    }

    @keyframes scrollWheel {
        0% {
            transform: translateY(0);
            opacity: 1;
        }
        70% {
            transform: translateY(9px);
            opacity: 0;
        }
        100% {
            transform: translateY(0);
            opacity: 0;
        }
    }

    .scroll-caption-pill {
        background: rgba(255, 255, 255, 0.78);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid rgba(214, 211, 209, 0.85);
        box-shadow: 0 12px 32px -12px rgba(28, 28, 28, 0.08);
    }

    .hero-left-editorial-block {
        position: absolute;
        left: clamp(1.25rem, 5.5vw, 6rem);
        top: 50%;
        transform: translateY(-50%);
        max-width: min(88vw, 440px);
        z-index: 30;
        text-align: left;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        pointer-events: auto;
    }

    .tech-card {
        background: rgba(255, 255, 255, 0.94);
        border: 1px solid rgba(214, 211, 209, 0.85);
        border-radius: 1.75rem;
        transition: all 0.4s var(--ease-out);
        position: relative;
        overflow: hidden;
    }

    .tech-card:hover {
        border-color: #1C1C1C;
        transform: translateY(-5px);
        box-shadow: 0 24px 50px -15px rgba(28, 28, 28, 0.1), 0 0 25px rgba(28, 28, 28, 0.03);
        background: #FFFFFF;
    }

    .tech-card .card-arrow-btn {
        transition: all 0.35s var(--ease-out);
    }

    .tech-card:hover .card-arrow-btn {
        background-color: #1C1C1C;
        color: #FFFFFF;
        border-color: #1C1C1C;
        transform: rotate(45deg);
    }

    .art-frame-container {
        position: relative;
        background: #FFFFFF;
        transition: transform 0.45s var(--ease-out), box-shadow 0.45s var(--ease-out);
    }

    .art-frame-container:hover {
        box-shadow: 0 35px 70px -20px rgba(28, 28, 28, 0.16);
    }

    .art-corner-mark {
        position: absolute;
        width: 14px;
        height: 14px;
        pointer-events: none;
        z-index: 10;
    }

    /* ==========================================================================
       8. INFINITE MARQUEE STRIP
       ========================================================================== */
    @keyframes scrollMarquee {
        from { transform: translateX(0); }
        to { transform: translateX(-100%); }
    }

    @keyframes scrollMarqueeReverse {
        from { transform: translateX(-100%); }
        to { transform: translateX(0); }
    }

    .marquee-container {
        display: flex;
        overflow: hidden;
        user-select: none;
        width: 100%;
    }

    .marquee-content {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: space-around;
        min-width: 100%;
        animation: scrollMarquee 34s linear infinite;
    }

    .marquee-content-reverse {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: space-around;
        min-width: 100%;
        animation: scrollMarqueeReverse 38s linear infinite;
    }

    .marquee-container:hover .marquee-content,
    .marquee-container:hover .marquee-content-reverse {
        animation-play-state: paused;
    }

    .font-cursive {
        font-family: 'Alex Brush', 'Pinyon Script', cursive;
    }

    .font-calligraphy {
        font-family: 'Pinyon Script', 'Alex Brush', cursive;
    }

    /* ==========================================================================
       9. TERCEIRA DOBRA — ESTÚDIO DE PRECISÃO & CANVAS DO TRAÇO
       ========================================================================== */
    .studio-drawing-board {
        background-color: #FFFFFF;
        background-image: 
            radial-gradient(circle at 50% 50%, rgba(28, 28, 28, 0.04) 1px, transparent 1px),
            linear-gradient(to right, rgba(28, 28, 28, 0.02) 1px, transparent 1px),
            linear-gradient(to bottom, rgba(28, 28, 28, 0.02) 1px, transparent 1px);
        background-size: 24px 24px, 48px 48px, 48px 48px;
        cursor: crosshair;
        position: relative;
        touch-action: none;
    }

    .benchmark-row {
        transition: background-color 0.25s var(--ease-out), transform 0.25s var(--ease-out);
    }

    .benchmark-row:hover {
        background-color: rgba(255, 255, 255, 0.95);
    }

    .conic-beam-wrapper {
        position: relative;
        overflow: hidden;
        padding: 2px;
        border-radius: 10px;
        display: inline-flex;
    }

    .conic-beam-spin {
        position: absolute;
        inset: -1000%;
        animation: spin 3s linear infinite;
        background: conic-gradient(from 0deg, transparent 0 310deg, #FF3300 345deg, #1C1C1C 360deg);
    }

    /* Responsive adjustments */
    @media (max-width: 768px) {
        .hero-left-editorial-block {
            top: clamp(5.2rem, 13vh, 7.5rem);
            transform: none;
            max-width: calc(100vw - 3rem);
            left: 1.5rem;
        }
        .giant-brand-watermark {
            font-size: clamp(4.2rem, 21vw, 7.5rem);
        }
        .video-frame-container {
            width: 100vw;
            height: 100vh;
        }
        .pagination-track {
            height: 72px;
        }
    }
</style>
