                                <div class="md:col-span-4 font-mono text-xs uppercase tracking-wider text-stone-500">Chassi &amp; Construção</div>
                                <div class="md:col-span-4 flex items-center gap-2">
                                    <span class="w-1.5 h-1.5 rounded-full bg-[#00CC66]"></span>
                                    <span class="font-semibold text-stone-900 text-sm">Alumínio Aeroespacial 7075 usinado</span>
                                    <span class="font-mono text-[10px] text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200 font-semibold">UNIBODY</span>
                                </div>
                                <div class="md:col-span-4 text-xs text-stone-500 font-mono">Canetas comuns: Corpo em plástico descartável de 6g</div>
                            </div>

                            <!-- Linha 4 -->
                            <div class="grid grid-cols-1 md:grid-cols-12 p-5 md:p-6 benchmark-row items-center gap-3">
                                <div class="md:col-span-4 font-mono text-xs uppercase tracking-wider text-stone-500">Ciclo de Vida &amp; Garantia</div>
                                <div class="md:col-span-4 flex items-center gap-2">
                                    <span class="w-1.5 h-1.5 rounded-full bg-[#00CC66]"></span>
                                    <span class="font-semibold text-stone-900 text-sm">Garantia Estrutural Vitalícia</span>
                                    <span class="font-mono text-[10px] text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200 font-semibold">PERPÉTUA</span>
                                </div>
                                <div class="md:col-span-4 text-xs text-stone-500 font-mono">Canetas comuns: Descarte após 200m de traço</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 5. O QUE ACOMPANHA O ESTÚDIO & CTA DEFINITIVO (Conic Shimmer Beam do Design System) -->
                <div class="rounded-3xl border border-stone-300 bg-gradient-to-b from-[#F5F5F0] to-[#EAEAE5] p-8 md:p-14 relative overflow-hidden shadow-lg sec3-reveal">
                    <div class="absolute -top-24 -right-24 w-96 h-96 bg-gradient-to-bl from-orange-200/40 via-stone-200/30 to-transparent rounded-full blur-3xl pointer-events-none"></div>

                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center relative z-10">
                        <div class="lg:col-span-7">
                            <span class="font-mono text-[10px] uppercase tracking-[0.25em] text-[#FF3300] font-semibold">EDIÇÃO COMPLETA DE ESTÚDIO</span>
                            <h3 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-stone-900 mt-2 mb-4 leading-tight">
                                Tudo o que você precisa para desenhar sem limites.
                            </h3>
                            <p class="text-sm sm:text-base text-stone-600 font-normal leading-relaxed mb-6">
                                Cada unidade da BNI Nikiti Pigmentum 0.1 é calibrada manualmente em laboratório, numerada e acompanhada de refis de nanquim e estojo protetor de transporte.
                            </p>

                            <!-- Lista de Itens Inclusos -->
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6 font-mono text-xs text-stone-700">
                                <div class="flex items-center gap-2.5">
                                    <span class="text-[#FF3300] font-bold">✓</span> 1x Caneta BNI Nikiti (Alumínio 7075)
                                </div>
                                <div class="flex items-center gap-2.5">
                                    <span class="text-[#FF3300] font-bold">✓</span> 3x Recargas Nanquim Japonês 0.1mm
                                </div>
                                <div class="flex items-center gap-2.5">
                                    <span class="text-[#FF3300] font-bold">✓</span> 1x Estojo Metálico de Proteção Anodizado
                                </div>
                                <div class="flex items-center gap-2.5">
                                    <span class="text-[#FF3300] font-bold">✓</span> 1x Certificado Individual Assinado
                                </div>
                            </div>
                        </div>

                        <!-- Coluna do Botão de Compra com Conic Shimmer Beam -->
                        <div class="lg:col-span-5 flex flex-col items-center lg:items-end justify-center text-center lg:text-right">
                            <div class="mb-4">
                                <div class="font-mono text-xs uppercase tracking-wider text-stone-500">Preço Especial de Lançamento</div>
                                <div class="text-4xl md:text-5xl font-bold tracking-tight text-stone-900 mt-1">R$ 649 <span class="text-sm font-normal text-stone-500">ou 12x R$ 62,80</span></div>
                            </div>

                            <!-- Botão Conic Shimmer Beam oficial de assets/design_system.html -->
                            <Button type="button" id="final-buy-btn" variant="conic" size="xl">
                                <span class="font-mono text-xs uppercase tracking-[0.2em] font-semibold">Comprar BNI Nikiti Agora</span>
                                <svg class="w-4 h-4 text-[#FF3300] transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                    <polyline points="12 5 19 12 12 19"></polyline>
                                </svg>
                            </Button>

                            <div class="mt-4 flex items-center gap-4 text-stone-500 font-mono text-[10px] uppercase tracking-wider">
                                <span>✦ FRETE GRÁTIS BRASIL</span>
                                <span>✦ 30 DIAS TESTE</span>
                                <span>✦ ENVIO EM 24H</span>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </section>

        <!-- ==========================================================================
             QUARTA DOBRA — PALETA PIGMENTUM // TINTAS & MARQUEE INFINITO CURSIVO (100% PRETO)
             ========================================================================== -->
        <InkColorsSection />
    </main>

    <!-- ==========================================================================
         GSAP + SCROLLTRIGGER + REQUESTANIMATIONFRAME VIDEO SCRUBBING ENGINE
         ========================================================================== -->
    <script is:inline>
        const initNikitiExperience = () => {
            if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined' || typeof Lenis === 'undefined') {
                setTimeout(initNikitiExperience, 50);
                return;
            }

            gsap.registerPlugin(ScrollTrigger);

            const canvas = document.getElementById('hero-canvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d', { alpha: true });
            const videoContainer = document.getElementById('video-frame-container');
            const header = document.getElementById('site-header');
            const stepCurrentEl = document.getElementById('scroll-step-current');
            const paginationFill = document.getElementById('pagination-fill');
            const giantBgText = document.getElementById('giant-bg-text');
            const giantBgSubtext = document.getElementById('giant-bg-subtext');
            const heroCopyBlock = document.getElementById('hero-copy-block');
            const scrollDownIndicator = document.getElementById('scroll-down-indicator');
            const calloutTitle = document.getElementById('callout-title');
            const calloutDesc = document.getElementById('callout-desc');
            const primaryBuyBtn = document.getElementById('primary-buy-btn');
            const cartBadge = document.getElementById('cart-badge');

            const TOTAL_FRAMES = 176;
            const TOTAL_STEPS = 22;
            const images = new Array(TOTAL_FRAMES + 1);
            let currentFrameRendered = 1;

            // ------------------------------------------------------------------
            // 0. LENIS SMOOTH SCROLL (Apple-grade Inertia & Momentum Physics)
            // ------------------------------------------------------------------
            const lenis = new Lenis({
                duration: 1.25,
                easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
                smoothWheel: true,
                wheelMultiplier: 0.95,
            });
            lenis.on('scroll', ScrollTrigger.update);
            gsap.ticker.add((time) => {
                lenis.raf(time * 1000);
            });
            gsap.ticker.lagSmoothing(0);

            // ------------------------------------------------------------------
            // 1. CANVAS RESIZING & COVER RENDERING PIPELINE (Retina 60-120fps)
            // ------------------------------------------------------------------
            const getFramePath = (index) => {
                return `/assets/frames/frame_${String(index).padStart(4, '0')}.jpg`;
            };

            const resizeCanvas = () => {
                const dpr = Math.min(window.devicePixelRatio || 1, 2);
                canvas.width = window.innerWidth * dpr;
                canvas.height = window.innerHeight * dpr;
                renderFrame(currentFrameRendered);
            };
            window.addEventListener('resize', resizeCanvas, { passive: true });

            const renderFrame = (index) => {
                currentFrameRendered = index;
                const img = images[index];
                if (!img || !img.complete || img.naturalWidth === 0) return;

                ctx.clearRect(0, 0, canvas.width, canvas.height);

                // Math for object-fit: cover on high-DPI canvas
                const imgRatio = img.naturalWidth / img.naturalHeight;
                const canvasRatio = canvas.width / canvas.height;
                let drawWidth, drawHeight, offsetX, offsetY;

                if (canvasRatio > imgRatio) {
                    drawWidth = canvas.width;
                    drawHeight = canvas.width / imgRatio;
                    offsetX = 0;
                    offsetY = (canvas.height - drawHeight) / 2;
                } else {
                    drawWidth = canvas.height * imgRatio;
                    drawHeight = canvas.height;
                    offsetX = (canvas.width - drawWidth) / 2;
                    offsetY = 0;
                }

                ctx.drawImage(img, offsetX, offsetY, drawWidth, drawHeight);
            };

            // Preload first frame immediately, then stream the rest into memory
            const firstImg = new Image();
            firstImg.src = getFramePath(1);
            firstImg.onload = () => {
                images[1] = firstImg;
                resizeCanvas();
                preloadRemainingFrames();
            };

            const preloadRemainingFrames = () => {
                for (let i = 2; i <= TOTAL_FRAMES; i++) {
                    const img = new Image();
                    img.src = getFramePath(i);
                    img.onload = () => {
                        images[i] = img;
                    };
                }
            };

            // ------------------------------------------------------------------
            // 2. INITIAL PAGE LOAD ENTRANCE TIMELINE (Apple-style smooth reveal)
            // ------------------------------------------------------------------
            const introTl = gsap.timeline({
                defaults: { ease: 'power3.out' }
            });

            introTl
                .fromTo('.nav-anim-item',
                    { y: -18, opacity: 0 },
                    { y: 0, opacity: 1, duration: 0.85, stagger: 0.06 }
                )
                .fromTo('.hero-load-watermark',
                    { scale: 0.92, opacity: 0, filter: 'blur(12px)' },
                    { scale: 1, opacity: 1, filter: 'blur(0px)', duration: 1.3, stagger: 0.1 },
                    '-=0.65'
                )
                .fromTo('#video-frame-container',
                    { scale: 1.05, opacity: 0 },
                    { scale: 1, opacity: 1, duration: 1.35, ease: 'expo.out' },
                    '-=1.05'
                )
                .fromTo('.hero-load-el',
                    { x: -32, opacity: 0, filter: 'blur(6px)' },
                    { x: 0, opacity: 1, filter: 'blur(0px)', duration: 0.95, stagger: 0.12 },
                    '-=0.95'
                )
                .fromTo('.hero-load-bottom',
                    { y: 24, opacity: 0 },
                    { y: 0, opacity: 1, duration: 0.9, stagger: 0.12 },
                    '-=0.7'
                )
                .fromTo('.hero-load-side',
                    { x: 20, opacity: 0 },
                    { x: 0, opacity: 1, duration: 0.9 },
                    '-=0.8'
                );

            // ------------------------------------------------------------------
            // 3. HEADER BLUR ON SCROLL
            // ------------------------------------------------------------------
            const updateHeaderState = () => {
                if (window.scrollY > 24) {
                    header?.classList.add('is-scrolled');
                } else {
                    header?.classList.remove('is-scrolled');
                }
            };
            window.addEventListener('scroll', updateHeaderState, { passive: true });
            updateHeaderState();

            // ------------------------------------------------------------------
            // 4. SCROLLTRIGGER MASTER CONTROLLER (Canvas Frame Scrubbing)
            // ------------------------------------------------------------------
            const updateTelemetryCopy = (progress) => {
                if (!calloutTitle || !calloutDesc) return;
                if (progress < 0.28) {
                    calloutTitle.textContent = 'Suspensão Gravidade Zero';
                    calloutDesc.textContent = 'Role a página para girar o cilindro balanceado de 18g.';
                } else if (progress < 0.62) {
                    calloutTitle.textContent = 'Vórtice Cinético de Tinta';
                    calloutDesc.textContent = 'Cartucho japonês pressurizado trava em alinhamento axial.';
                } else {
                    calloutTitle.textContent = 'Contato 0.1mm no Papel';
                    calloutDesc.textContent = 'Fluxo contínuo de micropigmento em papel de algodão arquival.';
                }
            };

            ScrollTrigger.create({
                trigger: '#hero',
                start: 'top top',
                end: 'bottom bottom',
                scrub: 0.1,
                onUpdate: (self) => {
                    const progress = self.progress; // 0.0 -> 1.0

                    // 1. Instant zero-latency canvas frame rendering
                    const targetFrame = Math.min(
                        TOTAL_FRAMES,
                        Math.max(1, Math.round(1 + progress * (TOTAL_FRAMES - 1)))
                    );
                    renderFrame(targetFrame);

                    // 2. Update right pagination indicator (01 / 22 -> 22 / 22)
                    const stepIndex = Math.min(
                        TOTAL_STEPS,
                        Math.max(1, Math.round(1 + progress * (TOTAL_STEPS - 1)))
                    );
                    if (stepCurrentEl) {
                        stepCurrentEl.textContent = String(stepIndex).padStart(2, '0');
                    }
                    if (paginationFill) {
                        gsap.set(paginationFill, { scaleY: Math.max(0.045, progress) });
                    }

                    // 3. Parallax on Giant Background Typography & Hero Copy
                    if (giantBgText) {
                        gsap.set(giantBgText, {
                            yPercent: progress * -18,
                            scale: 1 + progress * 0.08,
                            opacity: 1 - progress * 0.35
                        });
                    }
                    if (giantBgSubtext) {
                        gsap.set(giantBgSubtext, {
                            y: progress * -30,
                            opacity: Math.max(0.15, 1 - progress * 0.7)
                        });
                    }

                    // Smoothly slide left & fade out copy as user scrolls
                    if (heroCopyBlock) {
                        gsap.set(heroCopyBlock, {
                            x: progress * -45,
                            opacity: Math.max(0, 1 - progress * 2.4)
                        });
                    }

                    // Fade out "Scroll Down" hint once user starts scrolling
                    if (scrollDownIndicator) {
                        gsap.set(scrollDownIndicator, {
                            opacity: Math.max(0, 1 - progress * 4.5),
                            y: progress * 12
                        });
                    }

                    // Stage scale transition
                    const stageScale = 1 + Math.sin(progress * Math.PI) * 0.035;
                    if (videoContainer) {
                        gsap.set(videoContainer, { scale: stageScale });

                        if (progress > 0.32) {
                            videoContainer.classList.add('notebook-phase');
                        } else {
                            videoContainer.classList.remove('notebook-phase');
                        }
                    }

                    updateTelemetryCopy(progress);
                }
            });

            // ------------------------------------------------------------------
            // 5. SEGUNDA DOBRA — GSAP SCROLLTRIGGER REVEAL & 3D TILT ENGINE
            // ------------------------------------------------------------------
            const sec2Tl = gsap.timeline({
                scrollTrigger: {
                    trigger: '#specs',
                    start: 'top 75%',
                    end: 'bottom bottom',
                    toggleActions: 'play none none reverse'
                }
            });

            sec2Tl
                .fromTo('.sec2-reveal-left',
                    { y: 55, opacity: 0, scale: 0.95 },
                    { y: 0, opacity: 1, scale: 1, duration: 1.15, ease: 'power3.out' }
                )
                .fromTo('.sec2-reveal-right',
                    { y: 40, opacity: 0 },
                    { y: 0, opacity: 1, duration: 1, ease: 'power3.out' },
                    '-=0.85'
                )
                .fromTo('.sec2-card-item',
                    { y: 45, opacity: 0, scale: 0.96 },
                    { y: 0, opacity: 1, scale: 1, duration: 0.8, stagger: 0.1, ease: 'power3.out' },
                    '-=0.7'
                );

            // Subtle 3D Tilt on the Art Frame for tactile depth
            const artFrame = document.querySelector('.art-frame-container');
            if (artFrame) {
                artFrame.addEventListener('mousemove', (e) => {
                    const rect = artFrame.getBoundingClientRect();
                    const x = (e.clientX - rect.left) / rect.width - 0.5;
                    const y = (e.clientY - rect.top) / rect.height - 0.5;
                    gsap.to(artFrame, {
                        rotateY: x * 8,
                        rotateX: -y * 8,
                        transformPerspective: 900,
                        duration: 0.45,
                        ease: 'power2.out'
                    });
                });

                artFrame.addEventListener('mouseleave', () => {
                    gsap.to(artFrame, {
                        rotateY: 0,
                        rotateX: 0,
                        duration: 0.7,
                        ease: 'power3.out'
                    });
                });
            }

            // Tech Cards click interaction (smooth scroll to purchase CTA)
            document.querySelectorAll('.tech-card').forEach((card) => {
                card.addEventListener('click', () => {
                    const buyCta = document.getElementById('buy-cta');
                    if (buyCta) {
                        buyCta.scrollIntoView({ behavior: 'smooth' });
                        gsap.fromTo(buyCta,
                            { scale: 1.05 },
                            { scale: 1, duration: 0.45, ease: 'back.out(2)' }
                        );
                    }
                });
            });

            // ------------------------------------------------------------------
            // 7. TERCEIRA DOBRA — GSAP SCROLL REVEALS & DRAWING CANVAS ENGINE
            // ------------------------------------------------------------------
            gsap.utils.toArray('.sec3-reveal').forEach((el) => {
                gsap.fromTo(el,
                    { y: 45, opacity: 0 },
                    {
                        y: 0,
                        opacity: 1,
                        duration: 1.05,
                        ease: 'power3.out',
                        scrollTrigger: {
                            trigger: el,
                            start: 'top 82%',
                            toggleActions: 'play none none reverse'
                        }
                    }
                );
            });

            // Interactive 0.10mm Drafting Pad
            const sketchCanvas = document.getElementById('sketch-canvas');
            const canvasHint = document.getElementById('canvas-hint');
            const teleCoords = document.getElementById('tele-coords');
            const teleSpeed = document.getElementById('tele-speed');
            const btnClearCanvas = document.getElementById('btn-clear-canvas');
            const btnDrawArch = document.getElementById('btn-draw-arch');
            const btnDrawFree = document.getElementById('btn-draw-free');
            const finalBuyBtn = document.getElementById('final-buy-btn');

            if (sketchCanvas) {
                const sCtx = sketchCanvas.getContext('2d');
                let isDrawing = false;
                let lastX = 0;
                let lastY = 0;
                let lastTime = 0;

                const setupSketchCanvas = () => {
                    const rect = sketchCanvas.getBoundingClientRect();
                    const dpr = Math.min(window.devicePixelRatio || 1, 2);
                    sketchCanvas.width = rect.width * dpr;
                    sketchCanvas.height = rect.height * dpr;
                    sCtx.scale(dpr, dpr);
                    sCtx.lineCap = 'round';
                    sCtx.lineJoin = 'round';
                    sCtx.strokeStyle = '#1C1C1C';
                    sCtx.lineWidth = 1.15; // 0.10mm simulated micro-line
                };

                window.addEventListener('resize', setupSketchCanvas, { passive: true });
                setupSketchCanvas();

                const getCanvasCoords = (e) => {
                    const rect = sketchCanvas.getBoundingClientRect();
                    const clientX = e.touches ? e.touches[0].clientX : e.clientX;
                    const clientY = e.touches ? e.touches[0].clientY : e.clientY;
                    return {
                        x: clientX - rect.left,
                        y: clientY - rect.top
                    };
                };

                const startStroke = (e) => {
                    isDrawing = true;
                    const coords = getCanvasCoords(e);
                    lastX = coords.x;
                    lastY = coords.y;
                    lastTime = Date.now();
                    if (canvasHint) canvasHint.style.opacity = '0';
                };

                const moveStroke = (e) => {
                    if (!isDrawing) return;
                    e.preventDefault();
                    const coords = getCanvasCoords(e);
                    const now = Date.now();
                    const dt = Math.max(1, now - lastTime);
                    const dist = Math.hypot(coords.x - lastX, coords.y - lastY);
                    const speed = Math.round((dist / dt) * 100);

                    sCtx.beginPath();
                    sCtx.moveTo(lastX, lastY);
                    sCtx.lineTo(coords.x, coords.y);
                    sCtx.stroke();

                    lastX = coords.x;
                    lastY = coords.y;
                    lastTime = now;

                    if (teleCoords) teleCoords.textContent = `X: ${Math.round(coords.x).toString().padStart(3, '0')} · Y: ${Math.round(coords.y).toString().padStart(3, '0')}`;
                    if (teleSpeed) teleSpeed.textContent = `${speed} mm/s`;
                };

                const endStroke = () => {
                    isDrawing = false;
                };

                sketchCanvas.addEventListener('pointerdown', startStroke);
                sketchCanvas.addEventListener('pointermove', moveStroke);
                window.addEventListener('pointerup', endStroke);
                window.addEventListener('pointercancel', endStroke);

                // Botão Limpar
                if (btnClearCanvas) {
                    btnClearCanvas.addEventListener('click', () => {
                        const rect = sketchCanvas.getBoundingClientRect();
                        sCtx.clearRect(0, 0, rect.width, rect.height);
                        if (canvasHint) canvasHint.style.opacity = '1';
                        if (teleCoords) teleCoords.textContent = 'X: 000 · Y: 000';
                        if (teleSpeed) teleSpeed.textContent = '0 mm/s';
                    });
                }

                // Botão Croqui Arquitetural Automático
                if (btnDrawArch) {
                    btnDrawArch.addEventListener('click', () => {
                        if (canvasHint) canvasHint.style.opacity = '0';
                        const rect = sketchCanvas.getBoundingClientRect();
                        sCtx.clearRect(0, 0, rect.width, rect.height);
                        
                        // Desenha um corte arquitetural de alta precisão com linhas 0.10mm
                        const cx = rect.width / 2;
                        const cy = rect.height / 2;

                        sCtx.strokeStyle = '#1C1C1C';
                        sCtx.lineWidth = 1.0;

                        // 1. Linhas de Guia / Eixos
                        sCtx.setLineDash([4, 4]);
                        sCtx.beginPath();
                        sCtx.moveTo(cx - 160, cy + 80);
                        sCtx.lineTo(cx + 160, cy + 80);
                        sCtx.moveTo(cx, cy - 110);
                        sCtx.lineTo(cx, cy + 100);
                        sCtx.stroke();
                        sCtx.setLineDash([]);

                        // 2. Arco Brutalista
                        sCtx.beginPath();
                        sCtx.moveTo(cx - 70, cy + 80);
                        sCtx.lineTo(cx - 70, cy - 10);
                        sCtx.arc(cx, cy - 10, 70, Math.PI, 0, false);
                        sCtx.lineTo(cx + 70, cy + 80);
                        sCtx.stroke();

                        // 3. Degraus em perspectiva
                        for (let i = 0; i < 7; i++) {
                            const stepY = cy + 10 + i * 10;
                            const stepW = 80 - i * 6;
                            sCtx.strokeRect(cx - stepW / 2, stepY, stepW, 8);
                        }

                        // 4. Marca d'água técnica de aprovação
                        sCtx.fillStyle = '#FF3300';
                        sCtx.beginPath();
                        sCtx.arc(cx + 85, cy - 70, 4, 0, Math.PI * 2);
                        sCtx.fill();

                        sCtx.font = '10px "JetBrains Mono", monospace';
                        sCtx.fillStyle = '#78716C';
                        sCtx.fillText('CALIBRAÇÃO 0.10MM // RIGOR BNI NIKITI', cx - 100, cy + 115);

                        if (teleCoords) teleCoords.textContent = `X: ${Math.round(cx)} · Y: ${Math.round(cy)}`;
                        if (teleSpeed) teleSpeed.textContent = '180 mm/s (Auto)';
                    });
                }
            }

            // Final Buy Button Micro-Feedback
            if (finalBuyBtn && cartBadge) {
                finalBuyBtn.addEventListener('click', () => {
                    const currentCount = parseInt(cartBadge.textContent || '1', 10);
                    cartBadge.textContent = String(currentCount + 1);

                    gsap.fromTo(cartBadge,
                        { scale: 1.6 },
                        { scale: 1, duration: 0.45, ease: 'back.out(2.5)' }
                    );

                    const btnSpan = finalBuyBtn.querySelector('span');
                    if (btnSpan) {
                        const origText = btnSpan.textContent;
                        btnSpan.textContent = 'Kit Adicionado com Sucesso ✓';
                        setTimeout(() => {
                            btnSpan.textContent = origText;
                        }, 1800);
                    }
                });
            }
        };

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initNikitiExperience);
        } else {
            initNikitiExperience();
        }
    </script>
</Layout>
