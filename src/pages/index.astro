---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import InkColorsSection from '../components/InkColorsSection.astro';
---

<Layout title="BNI Nikiti Pigmentum 0.1 — Caneta de Precisão Arquitetural" activeItem="inicio">
    <main>
        <!-- ==========================================================================
             MAIN SCROLL-BOUND HERO SECTION (Sticky Viewport + GSAP Video Scrubbing)
             ========================================================================== -->
        <section id="hero" class="hero-scroll-track">

            <!-- Sticky Fullscreen Stage -->
            <div class="hero-sticky-viewport hero-studio-backdrop">

                <!-- Subtle Architectural Grid & Vertical Guide Lines from Design System -->
                <div class="absolute inset-0 bg-grid-architect pointer-events-none z-0"></div>
                <div class="max-w-[1440px] w-full h-full mx-auto absolute inset-0 pointer-events-none grid grid-cols-12 z-0 opacity-45">
                    <div class="col-span-3 border-r border-stone-300/40 h-full hidden md:block"></div>
                    <div class="col-span-3 border-r border-stone-300/40 h-full hidden md:block"></div>
                    <div class="col-span-3 border-r border-stone-300/40 h-full hidden md:block"></div>
                    <div class="col-span-3 h-full hidden md:block"></div>
                </div>

                <!-- 1. LEFT-ALIGNED HERO COPY (Flanked on the Left so the Pen Silhouette is 100% Unobstructed) -->
                <div id="hero-copy-block" class="hero-left-editorial-block">
                    <!-- Micro Eyebrow Badge -->
                    <div class="hero-load-el inline-flex items-center gap-2 px-3 py-1 rounded-full border border-stone-300/90 bg-white/80 backdrop-blur-md mb-3.5 shadow-2xs">
                        <span class="w-1.5 h-1.5 rounded-full bg-[#FF3300] animate-pulse"></span>
                        <span class="font-mono text-[10px] uppercase tracking-[0.22em] text-stone-600">Série Pigmentum // Nanquim Arquival 0.1mm</span>
                    </div>

                    <!-- Strong Left-Aligned Title with Architectural Light Knockout & Hollow Stroke (Design System Signature) -->
                    <h1 class="hero-load-el text-3xl sm:text-4xl md:text-[2.85rem] lg:text-[3.35rem] font-semibold tracking-[-0.04em] leading-[1.06] mb-1">
                        <span class="text-stone-900">Projetada</span> <span class="lettering-transparent cursor-pointer" title="BNI Nikiti">&amp; Exata</span> <br />
                        <span class="font-serif italic font-normal text-[1.12em] tracking-tight lettering-image-clip">Absoluta</span> 
                        <span class="gradient-text">Precisão.</span>
                    </h1>

                    <!-- Explanatory Subtitle -->
                    <p class="hero-load-el mt-3.5 text-xs sm:text-sm md:text-[0.95rem] text-stone-600 max-w-xs sm:max-w-sm font-normal leading-relaxed">
                        Corpo usinado em alumínio aeroespacial calibrado ao milímetro. Tinta pigmentada japonesa à prova d'água que desliza sem falhas.
                    </p>

                    <!-- Telemetry Spec Callout integrated cleanly under the left copy -->
                    <div id="spec-callout-1" class="hero-load-el scroll-caption-pill px-4 py-3 rounded-2xl max-w-[260px] mt-6 transition-all duration-500">
                        <div class="flex items-center justify-between font-mono text-[10px] text-stone-400 uppercase tracking-widest mb-1">
                            <span>01 / EQUILÍBRIO</span>
                            <span class="text-[#FF3300] font-bold">● AO VIVO</span>
                        </div>
                        <div id="callout-title" class="text-xs font-semibold text-stone-900">Suspensão Gravidade Zero</div>
                        <div id="callout-desc" class="text-[11px] text-stone-500 mt-0.5 leading-snug">Role a página para girar o cilindro balanceado de 18g.</div>
                    </div>
                </div>

                <!-- 2. GIANT TRANSLUCENT BACKGROUND TYPOGRAPHY (Behind the Pen Video) -->
                <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none z-10 overflow-hidden select-none">
                    <div id="giant-bg-text" class="giant-brand-watermark hero-load-watermark">
                        BNI NIKITI
                    </div>
                    <div id="giant-bg-subtext" class="font-mono text-[10px] md:text-xs uppercase tracking-[0.65em] text-stone-400/80 mt-2 md:mt-3 hero-load-watermark">
                        SISTEMA DE TINTA PIGMENTUM // 0.1 MM
                    </div>
                </div>

                <!-- 3. CENTERED STICKY PRODUCT STAGE (Apple-grade 60-120fps Canvas Scrubbing) -->
                <div class="video-stage-wrapper" id="video-stage-wrapper">
                    <div class="video-frame-container" id="video-frame-container">
                        <canvas id="hero-canvas"></canvas>
                    </div>
                </div>

                <!-- 4. RIGHT-SIDE VERTICAL PAGINATION / SCROLL INDICATOR (01 / 22) -->
                <aside class="pagination-rail hero-load-side" aria-label="Progresso de Quadros do Scroll">
                    <span id="scroll-step-current" class="font-mono text-xs font-semibold tracking-widest text-stone-900">01</span>
                    <div class="pagination-track">
                        <div id="pagination-fill" class="pagination-fill"></div>
                    </div>
                    <span class="font-mono text-xs tracking-widest text-stone-400">22</span>
                    <span class="font-mono text-[9px] uppercase tracking-[0.22em] text-stone-400 [writing-mode:vertical-rl] rotate-180 mt-2 hidden sm:inline-block">
                        CONTROLE DE SCROLL
                    </span>
                </aside>

                <!-- 5. BOTTOM CENTER CALL TO ACTION + STAR RATINGS + SCROLL DOWN FOOTER -->
                <div class="absolute bottom-5 md:bottom-8 left-1/2 -translate-x-1/2 z-30 px-4 w-full flex flex-col items-center gap-3 pointer-events-auto">

                    <!-- CTA Row: Dark Rounded Button + Star Ratings Beside It -->
                    <div id="buy-cta" class="hero-load-bottom flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6 bg-white/75 backdrop-blur-xl border border-stone-300/80 px-4 py-2.5 sm:pl-3 sm:pr-6 rounded-xl shadow-[0_20px_50px_rgba(28,28,28,0.08)]">

                        <!-- Dark Rounded Call to Action Button -->
                        <Button type="button" id="primary-buy-btn" variant="beam" size="lg" class="group cursor-pointer">
                            <span>Comprar BNI Nikiti — R$ 649</span>
                            <span class="w-5 h-5 rounded-full bg-white/15 flex items-center justify-center transition-transform duration-300 group-hover:translate-x-0.5">
                                <svg class="w-3 h-3 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                    <polyline points="12 5 19 12 12 19"></polyline>
                                </svg>
                            </span>
                        </Button>

                        <!-- Star Ratings & Review Count Beside CTA -->
                        <div class="flex items-center gap-3 pr-1">
                            <div class="flex items-center gap-0.5 text-stone-900" aria-label="Avaliação de 4.9 de 5 estrelas">
                                <svg class="w-3.5 h-3.5 fill-current text-stone-900" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                                <svg class="w-3.5 h-3.5 fill-current text-stone-900" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                                <svg class="w-3.5 h-3.5 fill-current text-stone-900" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                                <svg class="w-3.5 h-3.5 fill-current text-stone-900" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                                <svg class="w-3.5 h-3.5 fill-current text-stone-900" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                            </div>
                            <div class="text-left leading-tight">
                                <div class="text-xs font-semibold text-stone-900">4.9 <span class="font-normal text-stone-500">/ 5.0</span></div>
                                <div class="font-mono text-[10px] text-stone-500 uppercase tracking-wider">+2.480 Arquitetos</div>
                            </div>
                        </div>
                    </div>

                    <!-- Action Links & Scroll Down Indicator in Footer -->
                    <div class="flex flex-col sm:flex-row items-center gap-3 sm:gap-4">
                        <a href="/pagina-2" class="hero-load-bottom group inline-flex items-center gap-2 text-xs font-mono text-stone-800 hover:text-black border border-stone-300/90 bg-white/90 backdrop-blur-md px-3.5 py-1.5 rounded-lg transition-all shadow-2xs hover:border-stone-900">
                            <span class="w-1.5 h-1.5 rounded-full bg-[#FF3300] animate-pulse"></span>
                            <span>Explorar Catálogo // 09 Modelos</span>
                            <span class="text-[#FF3300] transition-transform duration-300 group-hover:translate-x-0.5">→</span>
                        </a>

                        <a href="#specs" id="scroll-down-indicator" class="hero-load-bottom group flex items-center gap-2.5 text-stone-500 hover:text-stone-900 transition-colors pt-1">
                            <div class="scroll-mouse-indicator">
                                <div class="scroll-mouse-wheel"></div>
                            </div>
                            <span class="font-mono text-[10px] uppercase tracking-[0.25em]">Role para Explorar</span>
                            <svg class="w-3 h-3 transition-transform duration-300 group-hover:translate-y-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </a>
                    </div>
                </div>

            </div>
        </section>

        <!-- ==========================================================================
             SEGUNDA DOBRA — MANIFESTO & ENGENHARIA TECNOLÓGICA (Layout Editorial da Referência)
             ========================================================================== -->
        <section id="specs" class="relative z-20 border-t border-stone-300 bg-[#F5F5F0] py-28 md:py-36 px-6 md:px-12 lg:px-16 overflow-hidden scroll-mt-24">

            <!-- Fundo Arquitetural Texturizado sutil -->
            <div class="absolute inset-0 bg-grid-architect opacity-40 pointer-events-none z-0"></div>
            <div class="absolute -top-32 right-10 w-[540px] h-[540px] bg-gradient-to-bl from-stone-200/60 via-orange-100/25 to-transparent rounded-full blur-3xl pointer-events-none"></div>

            <div class="max-w-[1440px] mx-auto relative z-10">

                <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">

                    <!-- COLUNA ESQUERDA: Obra de Arte Surrealista da Caneta + Moldura Técnica com Cantoneiras -->
                    <div id="craft" class="col-span-1 lg:col-span-5 flex flex-col items-center lg:items-start sec2-reveal-left">
                        <div class="relative w-full max-w-[500px] mx-auto lg:mx-0">

                            <!-- Cantoneiras Técnicas Industriais nos Cantos -->
                            <div class="art-corner-mark -top-3 -left-3 border-t-2 border-l-2 border-stone-900"></div>
                            <div class="art-corner-mark -top-3 -right-3 border-t-2 border-r-2 border-stone-900"></div>
                            <div class="art-corner-mark -bottom-3 -left-3 border-b-2 border-l-2 border-stone-900"></div>
                            <div class="art-corner-mark -bottom-3 -right-3 border-b-2 border-r-2 border-stone-900"></div>

                            <!-- Container da Obra de Arte com Moldura Editorial e Sombra Profunda -->
                            <div class="art-frame-container rounded-sm overflow-hidden p-3.5 sm:p-5 border border-stone-300/80 shadow-[0_25px_60px_-15px_rgba(28,28,28,0.12)]">
                                <div class="relative overflow-hidden aspect-square rounded-[2px] bg-white">
                                    <img
                                        src="/assets/bni_nikiti_architectural_art.jpg"
                                        alt="BNI Nikiti 0.1 — Composição Artística Editorial"
                                        class="w-full h-full object-cover transition-transform duration-700 hover:scale-105"
                                        loading="lazy"
                                    />
                                    <!-- Selo Holográfico / Técnico Flutuante -->
                                    <div class="absolute bottom-3 left-3 bg-white/90 backdrop-blur-md px-3 py-1.5 border border-stone-300 rounded-sm shadow-sm flex items-center gap-2">
                                        <span class="w-1.5 h-1.5 rounded-full bg-[#FF3300] animate-pulse"></span>
                                        <span class="font-mono text-[9px] uppercase tracking-wider text-stone-800 font-semibold">Tolerância CNC ±0.005mm</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Legenda Tipográfica Vertical Lateral (Estilo da Imagem de Referência) -->
                            <div class="hidden sm:flex items-center gap-3 absolute -right-8 top-1/2 -translate-y-1/2 translate-x-full [writing-mode:vertical-rl] select-none text-stone-400">
                                <span class="font-mono text-[9px] uppercase tracking-[0.32em]">BNI NIKITI · ENGENHARIA AEROESPACIAL · 00/26</span>
                            </div>

                            <!-- Metadados de Coordenadas e Calibragem abaixo da Arte -->
                            <div class="mt-4 flex items-center justify-between px-1 text-stone-500 font-mono text-[10px] tracking-wider uppercase border-b border-stone-300/60 pb-2">
                                <span>LIGA 7075-T6 // ANODIZADA</span>
                                <span class="text-stone-900 font-semibold">PIGMENTUM 0.10 MM</span>
                            </div>
                        </div>
                    </div>

                    <!-- COLUNA DIREITA: Título Tipográfico Editorial + Grid 2x2 de Cards Tecnológicos -->
                    <div class="col-span-1 lg:col-span-7 flex flex-col justify-between">

                        <!-- Título e Subtítulo da Seção (Inspirado Fielmente na Referência) -->
                        <div class="mb-10 lg:mb-12 sec2-reveal-right relative">
                            <!-- Faint Background Drafting Watermark (White & Hollow Reference Style) -->
                            <div class="absolute -top-12 -left-4 font-mono text-[6.5rem] sm:text-[8rem] font-bold text-stone-900/[0.035] select-none pointer-events-none leading-none -z-10 [text-stroke:1px_rgba(28,28,28,0.06)]" aria-hidden="true">
                                0.1MM
                            </div>

                            <!-- Eyebrow Tag -->
                            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-stone-300 bg-white/80 backdrop-blur-md mb-4 shadow-2xs">
                                <span class="w-1.5 h-1.5 rounded-full bg-[#FF3300]"></span>
                                <span class="font-mono text-[10px] uppercase tracking-[0.24em] text-stone-700">02 // Manifesto Tecnológico</span>
                            </div>

                            <!-- Título com o Efeito de Luz Arquitetural e Contorno Vazado (White & Hollow Reference) -->
                            <h2 class="text-4xl sm:text-5xl lg:text-[3.65rem] font-bold tracking-[-0.04em] leading-[1.06] mb-5">
                                <span class="text-stone-900">Engenharia</span> <span class="lettering-transparent cursor-pointer" title="Rigor BNI Nikiti">&amp; Rigor</span> <br />
                                <span class="text-stone-900">redefine o</span> <span class="font-serif italic font-normal text-[1.12em] tracking-tight lettering-image-clip">traço</span> <br />
                                <span class="gradient-text">arquitetural</span><span class="text-[#FF3300]">.</span>
                            </h2>

                            <!-- Subtítulo Encorpado com Argumentos de Alto Valor -->
                            <p class="text-sm sm:text-base text-stone-600 max-w-xl font-normal leading-relaxed">
                                Forjada a partir de um bloco sólido de alumínio aeroespacial e submetida a uma calibragem axial micrométrica. A BNI Nikiti anula a resistência do atrito e converte o impulso criativo em linhas de rigor matemático absoluto.
                            </p>
                        </div>

                        <!-- Grid 2x2 de Cards Tecnológicos (4 Cards da Imagem de Referência) -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 md:gap-6">

                            <!-- CARD 01: Alumínio Aeroespacial -->
                            <div class="tech-card p-6 md:p-7 flex flex-col justify-between group cursor-pointer sec2-card-item">
                                <div>
                                    <div class="flex items-center justify-between mb-4">
                                        <span class="font-serif italic text-2xl text-[#FF3300] font-normal">01</span>
                                        <span class="font-mono text-[10px] tracking-[0.2em] text-stone-400 uppercase font-semibold">LIGA PURA</span>
                                    </div>
                                    <!-- Ícone Técnico Minimalista -->
                                    <div class="w-8 h-8 rounded-lg bg-stone-100 flex items-center justify-center text-stone-800 mb-4 group-hover:bg-stone-900 group-hover:text-white transition-colors duration-300">
                                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                            <circle cx="11" cy="11" r="8"></circle>
                                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                            <path d="M11 8v6M8 11h6"></path>
                                        </svg>
                                    </div>
                                    <h3 class="text-lg md:text-xl font-semibold tracking-tight text-stone-900 mb-2 leading-snug">
                                        Alumínio <span class="font-serif italic font-normal text-[1.1em] tracking-tight lettering-image-clip">Aeroespacial</span> <br />
                                        <span class="text-stone-900 font-semibold">7075-T6</span>
                                    </h3>
                                    <p class="text-xs sm:text-[0.8125rem] text-stone-600 leading-relaxed">
                                        Usinagem CNC unibody a partir de barra maciça. Rigidez estrutural sem emendas e peso pluma calibrado em 18,4g para desenhar sem fadiga.
                                    </p>
                                </div>
                                <div class="mt-6 pt-4 border-t border-stone-200/70 flex items-center justify-between">
                                    <span class="font-mono text-[9px] uppercase tracking-wider text-stone-400">CNC Monobloco</span>
                                    <div class="card-arrow-btn w-8 h-8 rounded-full border border-stone-300 flex items-center justify-center bg-white">
                                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="7" y1="17" x2="17" y2="7"></line>
                                            <polyline points="7 7 17 7 17 17"></polyline>
                                        </svg>
                                    </div>
                                </div>
                            </div>

                            <!-- CARD 02: Calibragem Axial 0.10mm -->
                            <div class="tech-card p-6 md:p-7 flex flex-col justify-between group cursor-pointer sec2-card-item">
                                <div>
                                    <div class="flex items-center justify-between mb-4">
                                        <span class="font-serif italic text-2xl text-[#FF3300] font-normal">02</span>
                                        <span class="font-mono text-[10px] tracking-[0.2em] text-stone-400 uppercase font-semibold">PRECISÃO</span>
                                    </div>
                                    <!-- Ícone Técnico Minimalista -->
                                    <div class="w-8 h-8 rounded-lg bg-stone-100 flex items-center justify-center text-stone-800 mb-4 group-hover:bg-stone-900 group-hover:text-white transition-colors duration-300">
                                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                            <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                                            <path d="M3 9h18M9 21V9"></path>
                                        </svg>
                                    </div>
                                    <h3 class="text-lg md:text-xl font-semibold tracking-tight text-stone-900 mb-2 leading-snug">
                                        Calibragem <span class="font-serif italic font-normal text-[1.1em] tracking-tight lettering-image-clip">Axial</span> <br />
                                        <span class="text-stone-900 font-semibold">0.10 mm</span>
                                    </h3>
                                    <p class="text-xs sm:text-[0.8125rem] text-stone-600 leading-relaxed">
                                        Microponta de poliacetal protegida por colar de titânio. Garante espessura uniforme de 0.10mm em réguas e gabaritos sem flexão.
                                    </p>
                                </div>
                                <div class="mt-6 pt-4 border-t border-stone-200/70 flex items-center justify-between">
                                    <span class="font-mono text-[9px] uppercase tracking-wider text-stone-400">Guia de Titânio</span>
                                    <div class="card-arrow-btn w-8 h-8 rounded-full border border-stone-300 flex items-center justify-center bg-white">
                                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="7" y1="17" x2="17" y2="7"></line>
                                            <polyline points="7 7 17 7 17 17"></polyline>
                                        </svg>
                                    </div>
                                </div>
                            </div>

                            <!-- CARD 03: Gravidade Zero e Equilíbrio -->
                            <div class="tech-card p-6 md:p-7 flex flex-col justify-between group cursor-pointer sec2-card-item">
                                <div>
                                    <div class="flex items-center justify-between mb-4">
                                        <span class="font-serif italic text-2xl text-[#FF3300] font-normal">03</span>
                                        <span class="font-mono text-[10px] tracking-[0.2em] text-stone-400 uppercase font-semibold">ERGONOMIA</span>
                                    </div>
                                    <!-- Ícone Técnico Minimalista -->
                                    <div class="w-8 h-8 rounded-lg bg-stone-100 flex items-center justify-center text-stone-800 mb-4 group-hover:bg-stone-900 group-hover:text-white transition-colors duration-300">
                                        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
