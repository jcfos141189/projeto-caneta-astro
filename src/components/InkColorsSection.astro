                    <span class="font-cursive text-4xl sm:text-6xl md:text-7xl tracking-wide whitespace-nowrap">Grafite Carbono</span>
                </div>
                <span class="text-stone-700 text-lg font-mono">✦</span>

                <!-- Vinho Borgonha -->
                <div class="inline-flex items-center gap-3.5 text-rose-100 hover:text-rose-400 transition-colors duration-300 cursor-default">
                    <span class="w-3 h-3 rounded-full bg-[#881337] border-2 border-rose-400 shadow-[0_0_14px_rgba(244,63,94,0.6)]"></span>
                    <span class="font-cursive text-4xl sm:text-6xl md:text-7xl tracking-wide whitespace-nowrap">Vinho Borgonha</span>
                </div>
                <span class="text-stone-700 text-lg font-mono">✦</span>

                <!-- Azul da Prússia -->
