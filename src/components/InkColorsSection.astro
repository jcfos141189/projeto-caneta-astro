                    <span class="w-3 h-3 rounded-full bg-[#B45309] border-2 border-amber-500 shadow-[0_0_14px_rgba(245,158,11,0.6)]"></span>
                    <span class="font-cursive text-4xl sm:text-6xl md:text-7xl tracking-wide whitespace-nowrap">Âmbar Queimado</span>
                </div>
                <span class="text-stone-700 text-lg font-mono">✦</span>

                <!-- Azul Cobalto Profundo -->
                <div class="inline-flex items-center gap-3.5 text-indigo-100 hover:text-indigo-400 transition-colors duration-300 cursor-default">
                    <span class="w-3 h-3 rounded-full bg-[#312E81] border-2 border-indigo-400 shadow-[0_0_14px_rgba(99,102,241,0.6)]"></span>
                    <span class="font-cursive text-4xl sm:text-6xl md:text-7xl tracking-wide whitespace-nowrap">Azul Cobalto Profundo</span>
