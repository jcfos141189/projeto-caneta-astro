</section>

<style>
    /* Marquee com velocidade suave, tranquila e relaxada (75s para ciclo completo) */
    .marquee-content-slow {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: space-around;
        min-width: 100%;
        animation: scrollMarquee 75s linear infinite;
    }

    .marquee-container:hover .marquee-content-slow {
        animation-play-state: paused;
    }
</style>
