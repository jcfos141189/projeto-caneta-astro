---
// InkColorsSection Component — BNI Nikiti Pigmentum 0.1
// Nova dobra: Paleta de Tintas & Marquee Infinito Cursivo com fundo 100% Preto
---

<section id="tintas" class="relative z-20 bg-black text-white py-14 sm:py-18 md:py-22 overflow-hidden border-t border-stone-800">

    <!-- Fundo 100% Preto com Textura de Grid Arquitetural Sutil & Brilho Atmosférico -->
    <div class="absolute inset-0 bg-[#000000] pointer-events-none"></div>
    <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.025)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.025)_1px,transparent_1px)] bg-[size:40px_40px] pointer-events-none opacity-40"></div>
    
    <!-- Halos de iluminação dramática nas bordas -->
    <div class="absolute -top-32 left-1/4 w-[500px] h-[300px] bg-gradient-to-b from-stone-900/60 to-transparent rounded-full blur-[100px] pointer-events-none"></div>
    <div class="absolute -bottom-32 right-1/4 w-[500px] h-[300px] bg-gradient-to-t from-[#FF3300]/10 to-transparent rounded-full blur-[120px] pointer-events-none"></div>

    <div class="max-w-[1440px] mx-auto px-6 md:px-12 lg:px-16 relative z-10">

        <!-- 1. Cabeçalho Editorial Compacto da Dobra -->
        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-10 sm:mb-12">
            <div>
                <!-- Eyebrow Tag -->
                <div class="inline-flex items-center gap-2.5 px-3 py-1 rounded-full border border-stone-800 bg-stone-950/80 backdrop-blur-md mb-3 shadow-sm">
                    <span class="w-1.5 h-1.5 rounded-full bg-[#FF3300] animate-pulse"></span>
                    <span class="font-mono text-[10px] uppercase tracking-[0.24em] text-stone-300">04 // Coleção Pigmentum — Paleta de Nanquins</span>
                </div>

                <!-- Título em Destaque com Tipografia Mista (Display + Cursiva) -->
                <h2 class="text-2xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white leading-[1.1]">
                    A Alma do Traço: <br />
                    <span class="font-cursive font-normal text-3xl sm:text-5xl md:text-6xl text-stone-200 tracking-wide">
                        Nanquins &amp; Pigmentos Raros
                    </span>
                </h2>
            </div>

            <!-- Texto Editorial de Apoio -->
            <div class="max-w-md">
                <p class="text-xs sm:text-sm text-stone-400 font-normal leading-relaxed">
                    Nanopartículas minerais puras e pH balanceado. Cada tonalidade flui pela microponta 0.10mm sem cristalização, secando em 0,4 segundos com resistência à água e à luz por séculos.
                </p>
                <div class="mt-3 flex flex-wrap items-center gap-3 font-mono text-[10px] uppercase tracking-wider text-stone-500">
                    <span class="text-stone-300">✦ ISO 14145-2</span>
                    <span>•</span>
                    <span class="text-stone-300">✦ DENSIDADE 1.85</span>
                    <span>•</span>
                    <span class="text-stone-300">✦ IMPERMEÁVEL</span>
                </div>
            </div>
        </div>

    </div>

    <!-- 2. MARQUEE INFINITO CURSIVO — LINHA ÚNICA COM VELOCIDADE SUAVE E TRANQUILA -->
    <div class="relative py-4 sm:py-6 border-y border-stone-900 bg-black/95 backdrop-blur-sm overflow-hidden group">
        <div class="marquee-container" title="Passe o cursor para pausar o fluxo">
            
            <!-- Conteúdo Principal da Linha Única -->
            <div class="marquee-content-slow gap-12 sm:gap-16 pr-12 sm:pr-16">
                <!-- Nanquim Profundo -->
                <div class="inline-flex items-center gap-3.5 text-white hover:text-[#FF3300] transition-colors duration-300 cursor-default">
                    <span class="w-3 h-3 rounded-full bg-stone-900 border-2 border-stone-400 shadow-[0_0_12px_rgba(255,255,255,0.4)]"></span>
                    <span class="font-cursive text-4xl sm:text-6xl md:text-7xl tracking-wide whitespace-nowrap">Nanquim Profundo</span>
                </div>
                <span class="text-stone-700 text-lg font-mono">✦</span>

                <!-- Índigo Meia-Noite -->
                <div class="inline-flex items-center gap-3.5 text-blue-100 hover:text-blue-400 transition-colors duration-300 cursor-default">
                    <span class="w-3 h-3 rounded-full bg-[#1A365D] border-2 border-blue-400 shadow-[0_0_14px_rgba(59,130,246,0.6)]"></span>
                    <span class="font-cursive text-4xl sm:text-6xl md:text-7xl tracking-wide whitespace-nowrap">Índigo Meia-Noite</span>
                </div>
                <span class="text-stone-700 text-lg font-mono">✦</span>

                <!-- Sépia Arquival -->
                <div class="inline-flex items-center gap-3.5 text-amber-100 hover:text-amber-400 transition-colors duration-300 cursor-default">
                    <span class="w-3 h-3 rounded-full bg-[#78350F] border-2 border-amber-400 shadow-[0_0_14px_rgba(245,158,11,0.6)]"></span>
                    <span class="font-cursive text-4xl sm:text-6xl md:text-7xl tracking-wide whitespace-nowrap">Sépia Arquival</span>
                </div>
                <span class="text-stone-700 text-lg font-mono">✦</span>

                <!-- Carmim Escarlate -->
                <div class="inline-flex items-center gap-3.5 text-red-100 hover:text-red-400 transition-colors duration-300 cursor-default">
                    <span class="w-3 h-3 rounded-full bg-[#991B1B] border-2 border-red-500 shadow-[0_0_14px_rgba(239,68,68,0.6)]"></span>
                    <span class="font-cursive text-4xl sm:text-6xl md:text-7xl tracking-wide whitespace-nowrap">Carmim Escarlate</span>
                </div>
                <span class="text-stone-700 text-lg font-mono">✦</span>

                <!-- Preto Obsidiana -->
                <div class="inline-flex items-center gap-3.5 text-stone-100 hover:text-stone-300 transition-colors duration-300 cursor-default">
                    <span class="w-3 h-3 rounded-full bg-black border-2 border-white shadow-[0_0_14px_rgba(255,255,255,0.8)]"></span>
                    <span class="font-cursive text-4xl sm:text-6xl md:text-7xl tracking-wide whitespace-nowrap">Preto Obsidiana</span>
                </div>
                <span class="text-stone-700 text-lg font-mono">✦</span>

                <!-- Verde Musgo Imperial -->
                <div class="inline-flex items-center gap-3.5 text-emerald-100 hover:text-emerald-400 transition-colors duration-300 cursor-default">
                    <span class="w-3 h-3 rounded-full bg-[#064E3B] border-2 border-emerald-400 shadow-[0_0_14px_rgba(16,185,129,0.6)]"></span>
                    <span class="font-cursive text-4xl sm:text-6xl md:text-7xl tracking-wide whitespace-nowrap">Verde Musgo Imperial</span>
                </div>
                <span class="text-stone-700 text-lg font-mono">✦</span>

                <!-- Âmbar Queimado -->
