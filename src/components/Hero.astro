---
// Hero Section Component — BNI Nikiti Pigmentum 0.1
import Button from "./Button.astro";
---

<section id="hero" class="hero-scroll-track">
    <!-- Sticky Fullscreen Stage -->
    <div class="hero-sticky-viewport hero-studio-backdrop">
        <!-- Subtle Architectural Grid & Vertical Guide Lines from Design System -->
        <div class="absolute inset-0 bg-grid-architect pointer-events-none z-0">
        </div>
        <div
            class="max-w-[1440px] w-full h-full mx-auto absolute inset-0 pointer-events-none grid grid-cols-12 z-0 opacity-45"
        >
            <div
                class="col-span-3 border-r border-stone-300/40 h-full hidden md:block"
            >
            </div>
            <div
                class="col-span-3 border-r border-stone-300/40 h-full hidden md:block"
            >
            </div>
            <div
                class="col-span-3 border-r border-stone-300/40 h-full hidden md:block"
            >
            </div>
            <div class="col-span-3 h-full hidden md:block"></div>
        </div>

        <!-- 1. LEFT-ALIGNED HERO COPY (Flanked on the Left so the Pen Silhouette is 100% Unobstructed) -->
        <div id="hero-copy-block" class="hero-left-editorial-block">
            <!-- Micro Eyebrow Badge -->
            <div
                class="hero-load-el inline-flex items-center gap-2 px-3 py-1 rounded-full border border-stone-300/90 bg-white/80 backdrop-blur-md mb-3.5 shadow-2xs"
            >
                <span
                    class="w-1.5 h-1.5 rounded-full bg-[#FF3300] animate-pulse"
                ></span>
                <span
                    class="font-mono text-[10px] uppercase tracking-[0.22em] text-stone-600"
                    >Série Pigmentum // Nanquim Arquival 0.1mm</span
                >
            </div>

            <!-- Strong Left-Aligned Title with Architectural Light Knockout & Hollow Stroke (Design System Signature) -->
            <h1
                class="hero-load-el text-3xl sm:text-4xl md:text-[2.85rem] lg:text-[3.35rem] font-semibold tracking-[-0.04em] leading-[1.06] mb-1"
            >
                <span class="text-stone-900">Projetada</span>
                <span
                    class="lettering-transparent cursor-pointer"
                    title="BNI Nikiti">&amp; Exata</span
                >
                <br />
                <span
                    class="font-serif italic font-normal text-[1.12em] tracking-tight lettering-image-clip"
                    >Absoluta</span
                >
                <span class="gradient-text">Precisão.</span>
            </h1>

            <!-- Explanatory Subtitle -->
            <p
                class="hero-load-el mt-3.5 text-xs sm:text-sm md:text-[0.95rem] text-stone-600 max-w-xs sm:max-w-sm font-normal leading-relaxed"
            >
                Corpo usinado em alumínio aeroespacial calibrado ao milímetro.
                Tinta pigmentada japonesa à prova d'água que desliza sem falhas.
            </p>

            <!-- Telemetry Spec Callout integrated cleanly under the left copy -->
            <div
                id="spec-callout-1"
                class="hero-load-el scroll-caption-pill px-4 py-3 rounded-2xl max-w-[260px] mt-6 transition-all duration-500"
            >
                <div
                    class="flex items-center justify-between font-mono text-[10px] text-stone-400 uppercase tracking-widest mb-1"
                >
                    <span>01 / EQUILÍBRIO</span>
                    <span class="text-[#FF3300] font-bold">● AO VIVO</span>
                </div>
                <div
                    id="callout-title"
                    class="text-xs font-semibold text-stone-900"
                >
                    Suspensão Gravidade Zero
                </div>
                <div
                    id="callout-desc"
                    class="text-[11px] text-stone-500 mt-0.5 leading-snug"
                >
                    Role a página para girar o cilindro balanceado de 18g.
                </div>
            </div>
        </div>

        <!-- 2. GIANT TRANSLUCENT BACKGROUND TYPOGRAPHY (Behind the Pen Video) -->
        <div
            class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none z-10 overflow-hidden select-none"
        >
            <div
                id="giant-bg-text"
                class="giant-brand-watermark hero-load-watermark"
            >
                BNI NIKITI
            </div>
            <div
                id="giant-bg-subtext"
                class="font-mono text-[10px] md:text-xs uppercase tracking-[0.65em] text-stone-400/80 mt-2 md:mt-3 hero-load-watermark"
            >
                SISTEMA DE TINTA PIGMENTUM // 0.1 MM
            </div>
        </div>

        <!-- 3. CENTERED STICKY PRODUCT STAGE (Apple-grade 60-120fps Canvas Scrubbing) -->
        <div class="video-stage-wrapper" id="video-stage-wrapper">
            <div class="video-frame-container" id="video-frame-container">
                <canvas id="hero-canvas"></canvas>
            </div>
        </div>

        <!-- 4. RIGHT-SIDE VERTICAL PAGINATION / SCROLL INDICATOR (01 / 22) -->
        <aside
            class="pagination-rail hero-load-side"
            aria-label="Progresso de Quadros do Scroll"
        >
            <span
                id="scroll-step-current"
                class="font-mono text-xs font-semibold tracking-widest text-stone-900"
                >01</span
            >
            <div class="pagination-track">
                <div id="pagination-fill" class="pagination-fill"></div>
            </div>
            <span class="font-mono text-xs tracking-widest text-stone-400"
                >22</span
            >
            <span
                class="font-mono text-[9px] uppercase tracking-[0.22em] text-stone-400 [writing-mode:vertical-rl] rotate-180 mt-2 hidden sm:inline-block"
            >
                CONTROLE DE SCROLL
            </span>
        </aside>

        <!-- 5. BOTTOM CENTER CALL TO ACTION + STAR RATINGS + SCROLL DOWN FOOTER -->
        <div
            class="absolute bottom-5 md:bottom-8 left-1/2 -translate-x-1/2 z-30 px-4 w-full flex flex-col items-center gap-3 pointer-events-auto"
        >
            <!-- CTA Row: Dark Rounded Button + Star Ratings Beside It -->
            <div
                id="buy-cta"
                class="hero-load-bottom flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6 bg-white/75 backdrop-blur-xl border border-stone-300/80 px-4 py-2.5 sm:pl-3 sm:pr-6 rounded-xl shadow-[0_20px_50px_rgba(28,28,28,0.08)]"
            >
                <!-- Dark Rounded Call to Action Button -->
                <Button
                    type="button"
                    id="primary-buy-btn"
                    variant="beam"
                    size="lg"
                    class="group cursor-pointer"
                >
                    <span>Comprar BNI Nikiti — R$ 649</span>
                    <span
                        class="w-5 h-5 rounded-full bg-white/15 flex items-center justify-center transition-transform duration-300 group-hover:translate-x-0.5"
                    >
                        <svg
                            class="w-3 h-3 text-white"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </span>
                </Button>

                <!-- Star Ratings & Review Count Beside CTA -->
                <div class="flex items-center gap-3 pr-1">
                    <div
                        class="flex items-center gap-0.5 text-stone-900"
                        aria-label="Avaliação de 4.9 de 5 estrelas"
                    >
                        <svg
                            class="w-3.5 h-3.5 fill-current text-stone-900"
                            viewBox="0 0 20 20"
                            ><path
                                d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
                            ></path></svg
                        >
                        <svg
                            class="w-3.5 h-3.5 fill-current text-stone-900"
                            viewBox="0 0 20 20"
                            ><path
                                d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
                            ></path></svg
                        >
                        <svg
                            class="w-3.5 h-3.5 fill-current text-stone-900"
                            viewBox="0 0 20 20"
                            ><path
                                d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
                            ></path></svg
                        >
                        <svg
                            class="w-3.5 h-3.5 fill-current text-stone-900"
                            viewBox="0 0 20 20"
                            ><path
                                d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
                            ></path></svg
                        >
                        <svg
                            class="w-3.5 h-3.5 fill-current text-stone-900"
                            viewBox="0 0 20 20"
                            ><path
                                d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
                            ></path></svg
                        >
                    </div>
                    <div class="text-left leading-tight">
                        <div class="text-xs font-semibold text-stone-900">
                            4.9 <span class="font-normal text-stone-500"
                                >/ 5.0</span
                            >
                        </div>
                        <div
                            class="font-mono text-[10px] text-stone-500 uppercase tracking-wider"
                        >
                            +2.480 Arquitetos
                        </div>
                    </div>
                </div>
            </div>

            <!-- Scroll Down Indicator in Footer -->
            <a
                href="#specs"
                id="scroll-down-indicator"
                class="hero-load-bottom group flex items-center gap-2.5 text-stone-500 hover:text-stone-900 transition-colors pt-1"
            >
                <div class="scroll-mouse-indicator">
                    <div class="scroll-mouse-wheel"></div>
                </div>
                <span class="font-mono text-[10px] uppercase tracking-[0.25em]"
                    >Role para Explorar</span
                >
                <svg
                    class="w-3 h-3 transition-transform duration-300 group-hover:translate-y-0.5"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
            </a>
        </div>
    </div>
</section>
