---
// Header Component — BNI Nikiti Pigmentum 0.1
import Button from "./Button.astro";
import IconButton from "./IconButton.astro";

interface Props {
    activeItem?: "inicio" | "sobre" | "loja" | "catalogo" | "detalhes";
}

const { activeItem = "inicio" } = Astro.props;
const isSubpage = activeItem !== "inicio";
---

<header id="site-header" class={`site-header py-4 md:py-5 px-6 md:px-12 lg:px-16 ${isSubpage ? 'is-subpage is-scrolled' : ''}`}>
    <div
        class="max-w-[1440px] mx-auto flex items-center justify-between relative"
    >
        <!-- Left Navigation -->
        <nav
            class="flex items-center gap-5 md:gap-7"
            aria-label="Navegação Principal"
        >
            <a
                href="/#hero"
                class={`nav-link nav-anim-item ${activeItem === "inicio" ? "active" : ""}`}
                >Início</a
            >
            <a
                href="/#craft"
                class={`nav-link nav-anim-item ${activeItem === "sobre" ? "active" : ""}`}
                >Sobre</a
            >
            <a href="/#tintas" class="nav-link nav-anim-item">Tintas</a>
            <a
                href="/#specs"
                class={`nav-link nav-anim-item ${activeItem === "loja" ? "active" : ""}`}
                >Loja</a
            >
            <a
                href="/pagina-2"
                class={`nav-link nav-anim-item ${activeItem === "catalogo" ? "active" : ""}`}
                >Catálogo</a
            >
            <a
                href="/pagina-3"
                class={`nav-link nav-anim-item ${activeItem === "detalhes" ? "active" : ""}`}
                >Detalhes</a
            >
            <a
                href="/assets/design_system.html"
                class="nav-link hidden lg:inline-block font-mono text-[11px] uppercase tracking-widest text-stone-500 nav-anim-item"
                >Sistema.v4</a
            >
        </nav>

        <!-- Center Brand Logo -->
        <a
            href="#hero"
            class="absolute left-1/2 -translate-x-1/2 flex items-center gap-2.5 group nav-anim-item"
            aria-label="Início BNI Nikiti"
        >
            <div
                class="w-7 h-7 rounded-full border border-stone-900 flex items-center justify-center bg-white group-hover:bg-stone-900 group-hover:text-white transition-colors duration-500"
            >
                <svg
                    class="w-3.5 h-3.5 transition-transform duration-500 group-hover:rotate-45"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path d="M12 19l7-7 3 3-7 7-3-3z"></path>
                    <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"></path>
                    <path d="M2 2l7.586 7.586"></path>
                    <circle cx="11" cy="11" r="2"></circle>
                </svg>
            </div>
            <span
                class="font-display font-bold tracking-[-0.04em] text-base md:text-lg text-stone-900"
            >
                BNI NIKITI<span
                    class="font-mono font-normal text-[11px] text-stone-400 ml-0.5"
                    >.01</span
                >
            </span>
        </a>

        <!-- Right Icons & "Buy Now" Pill Button -->
        <div class="flex items-center gap-2.5 md:gap-3.5">
            <IconButton
                ariaLabel="Buscar"
                class="hidden sm:inline-flex nav-anim-item"
            >
                <svg
                    class="w-4 h-4"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
            </IconButton>

            <IconButton
                id="cart-trigger-btn"
                ariaLabel="Sacola de Compras"
                class="nav-anim-item"
                badge="1"
                badgeId="cart-badge"
            >
                <svg
                    class="w-4 h-4"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"
                    ></path>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <path d="M16 10a4 4 0 0 1-8 0"></path>
                </svg>
            </IconButton>

            <Button
                href="#buy-cta"
                size="sm"
                variant="beam"
                class="nav-anim-item"
            >
                <span>Comprar Agora</span>
                <span class="w-1.5 h-1.5 rounded-full bg-[#FF3300]"></span>
            </Button>
        </div>
    </div>
</header>

<script is:inline>
    (() => {
        const header = document.getElementById('site-header');
        if (!header) return;
        const isSubpage = header.classList.contains('is-subpage');

        const updateHeader = () => {
            if (isSubpage || window.scrollY > 15) {
                header.classList.add('is-scrolled');
            } else {
                header.classList.remove('is-scrolled');
            }
        };

        window.addEventListener('scroll', updateHeader, { passive: true });
        updateHeader();
    })();
</script>
